# Vite 프론트엔드 환경변수. 이 파일을 .env 로 복사해서 사용한다.
#   cp vue-frontend/.env.example vue-frontend/.env
# (vue-frontend/.env 는 .gitignore 대상이라 저장소에 없음 — 클론 후 직접 만들어야 함)
#
# 값 변경 후에는 dev 서버(npm run dev)를 재시작해야 반영된다.

# 모든 API 는 게이트웨이를 통한다
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_SERVER_URL=http://localhost:8080

# OAuth2 클라이언트 (auth-server 에 등록된 값과 일치해야 함)
VITE_CLIENT_ID=web-client
VITE_CLIENT_SECRET=web-secret

# OAuth2 redirect_uri (auth-server 클라이언트 설정과 정확히 일치해야 함)
VITE_REDIRECT_URI=http://localhost:3000/callback
