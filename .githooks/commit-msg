#!/usr/bin/env bash
# 커밋 메시지 컨벤션 검사: "prefix: 설명" 형식만 허용
# 허용 prefix: add, update, fix, refactor, docs, chore, test

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -n1 "$COMMIT_MSG_FILE")

PATTERN='^(add|update|fix|refactor|docs|chore|test): .+'

if [[ "$FIRST_LINE" =~ ^Merge ]]; then
  exit 0
fi

if ! [[ "$FIRST_LINE" =~ $PATTERN ]]; then
  echo "커밋 메시지 컨벤션을 지켜주세요: \"prefix: 설명\""
  echo ""
  echo "허용 prefix: add, update, fix, refactor, docs, chore, test"
  echo ""
  echo "예시: fix: 결제 취소 시 중복 요청 오류 수정"
  echo ""
  echo "입력한 메시지: \"$FIRST_LINE\""
  exit 1
fi

exit 0
